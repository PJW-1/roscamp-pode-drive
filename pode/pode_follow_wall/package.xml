<?xml version="1.0"?>
<package format="3">
  <name>pode_follow_wall</name>
  <version>0.1.0</version>
  <description>Nav2 controller plugin FollowWall: wraps RPP and shifts its path by the lidar wall distance error (cleaner robot)</description>
  <maintainer email="team@example.com">team-2</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>pluginlib</depend>
  <depend>nav2_core</depend>
  <depend>nav2_util</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>nav2_regulated_pure_pursuit_controller</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
